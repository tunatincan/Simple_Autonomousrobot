<?xml version="1.0" ?>
<robot name="RPlidar" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<xacro:property name="body_color" value="Gazebo/Silver" />

<gazebo>
  <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
    <ros>
      <namespace>/</namespace>
    </ros>
    <update_rate>30</update_rate>
    <left_joint>LeftWheelRotate</left_joint>
    <right_joint>RightWheelRotate</right_joint>
    <wheel_separation>0.18</wheel_separation>
    <wheel_diameter>0.065</wheel_diameter>
    <max_wheel_torque>20.0</max_wheel_torque>
    <max_wheel_acceleration>2.5</max_wheel_acceleration>
    <publish_odom>true</publish_odom>
    <publish_odom_tf>true</publish_odom_tf>
    <publish_wheel_tf>false</publish_wheel_tf>
    <odometry_frame>odom</odometry_frame>
    <robot_base_frame>base_footprint</robot_base_frame>
  </plugin>

  <plugin name="gazebo_ros_joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
    <ros>
      <namespace>/</namespace>
    </ros>
    <update_rate>30</update_rate>
    <joint_name>LeftWheelRotate</joint_name>
    <joint_name>RightWheelRotate</joint_name>
    <joint_name>LeftArmRotate</joint_name>
    <joint_name>RightArmRotate</joint_name>
    <joint_name>FRYokeRotate</joint_name>
    <joint_name>RRYokeRotate</joint_name>
    <joint_name>RLYokeRotate</joint_name>
    <joint_name>FLYokeRotate</joint_name>
    <joint_name>FRCasterWheelRotate</joint_name>
    <joint_name>RLCasterWheelRotate</joint_name>
    <joint_name>FLCasterWheelRotate</joint_name>
    <joint_name>RRCasterWheelRotate</joint_name>
    <joint_name>LidarRotate</joint_name>
  </plugin>
</gazebo>
<gazebo reference="base_link">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
  <gravity>true</gravity>
</gazebo>

<gazebo reference="Caster_Yoke_FR_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="Caster_Yoke_RR_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="Caster_Yoke_RL_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="Caster_Yoke_FL_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="Caster_Wheel_FR_1">
  <material>${body_color}</material>
  <mu1>0.0</mu1>
  <mu2>0.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="Caster_Wheel_RL_1">
  <material>${body_color}</material>
  <mu1>0.0</mu1>
  <mu2>0.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="Caster_Wheel_FL_1">
  <material>${body_color}</material>
  <mu1>0.0</mu1>
  <mu2>0.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="Caster_Wheel_RR_1">
  <material>${body_color}</material>
  <mu1>0.0</mu1>
  <mu2>0.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="Shock_link_Mirror__1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="Shock_link_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="LeftWheel_1">
  <material>${body_color}</material>
  <mu1>100.0</mu1>
  <mu2>100.0</mu2>
  <kp>100000.0</kp>
  <kd>100.0</kd>
  <minDepth>0.001</minDepth>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="RightWheel_1">
  <material>${body_color}</material>
  <mu1>100.0</mu1>
  <mu2>100.0</mu2>
  <kp>100000.0</kp>
  <kd>100.0</kd>
  <minDepth>0.001</minDepth>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="Lidar_Link_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
  <sensor type="ray" name="rplidar_sensor">
    <pose>0 0.02 0 -1.5707963 0 0</pose>
    <visualize>true</visualize>
    <update_rate>30</update_rate>
    <ray>
      <scan>
        <horizontal>
          <samples>360</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.15</min>
        <max>12.0</max>
        <resolution>0.01</resolution>
      </range>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.01</stddev>
      </noise>
    </ray>
    <plugin name="gazebo_ros_laser" filename="libgazebo_ros_ray_sensor.so">
      <ros>
        <remapping>~/out:=scan</remapping>
      </ros>
      <output_type>sensor_msgs/LaserScan</output_type>
      <frame_name>lidar_laser_frame</frame_name>
    </plugin>
  </sensor>
</gazebo>

</robot>
